# Copy to .env and adjust. All settings are prefixed ARGUS_ (see src/argus/core/config.py).

# Postgres connection (matches docker-compose.yml defaults)
ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5432/argus

# Content-addressed raw document store
ARGUS_RAW_STORE_PATH=data/raw

# Logging: DEBUG | INFO | WARNING | ERROR
ARGUS_LOG_LEVEL=INFO
