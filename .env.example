# Copy to .env and adjust. All settings are prefixed ARGUS_ (see src/argus/core/config.py).

# --- db / store / logging ---

# Postgres connection (matches docker-compose.yml defaults)
ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5432/argus

# Content-addressed raw document store
ARGUS_RAW_STORE_PATH=data/raw

# Logging: DEBUG | INFO | WARNING | ERROR
ARGUS_LOG_LEVEL=INFO

# --- api ---

# When set, /api/* requires X-API-Key or Bearer token; empty disables auth (dev default)
# ARGUS_API_KEY=

# Request bodies above this are rejected with 413 (default: 1 MiB)
# ARGUS_MAX_BODY_BYTES=1048576

# Investigation creates per client IP per minute; 0 disables (default: 6)
# ARGUS_RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=6

# Searches per client IP per minute; 0 disables (default: 60)
# ARGUS_RATE_LIMIT_SEARCH_PER_MINUTE=60

# Public demo: /api/* GETs need no key, every write still does (ADR-0014).
# Only meaningful together with ARGUS_API_KEY (default: false)
# ARGUS_DEMO_MODE=0

# --- pipeline ---

# Bump to re-derive artifacts under a new version (default: 1)
# ARGUS_PIPELINE_VERSION=1

# "fastembed" (real) or "fake" (tests) (default: fastembed)
# ARGUS_EMBEDDING_PROVIDER=fastembed

# --- agent runtime ---

# Required for live LLM runs (investigations, report drafting) — no default
ARGUS_OPENROUTER_API_KEY=

# "openrouter" (live) or "demo" (deterministic canned outputs, no key, no cost —
# ADR-0014) (default: openrouter)
# ARGUS_LLM_PROVIDER=openrouter

# Any OpenRouter model id; stamped on every ExecutionRecord (ADR-0005) (default shown)
# ARGUS_LLM_MODEL=google/gemini-2.5-flash

# Per-LLM-call timeout in seconds (default: 120)
# ARGUS_LLM_TIMEOUT_SECONDS=120

# Chunks per query fed to stance classification (default: 8)
# ARGUS_AGENT_RETRIEVAL_K=8

# --- connectors ---

# SEC requires a descriptive User-Agent with contact info on every request
# ARGUS_SEC_USER_AGENT=Argus Research Platform you@example.com

# JSON-list syntax (pydantic-settings), e.g. ARGUS_SEC_WATCHLIST=["AAPL","MSFT"]
# ARGUS_SEC_WATCHLIST=["AAPL","MSFT","NVDA","GOOGL","AMZN","META","TSM","AVGO"]
# ARGUS_SEC_FILING_TYPES=["10-K","10-Q","8-K"]
# ARGUS_RSS_FEEDS=["https://feeds.content.dowjones.io/public/rss/mw_topstories"]

# --- schedules (seconds) ---

# ARGUS_SCHEDULE_RSS=900
# ARGUS_SCHEDULE_SEC=3600
# ARGUS_SCHEDULE_PROFILES=86400
# ARGUS_WORKER_POLL_SECONDS=2.0
# ARGUS_JOB_LEASE_SECONDS=600  # a running job claimed longer ago than this is presumed crashed and reaped

# --- limits ---

# Connector downloads abort past this many bytes (default: 25 MiB)
# ARGUS_MAX_FETCH_BYTES=26214400

# Server-side statement timeout for all app queries, ms (default: 30000)
# ARGUS_DB_STATEMENT_TIMEOUT_MS=30000

# Chunks per embedding-provider call (default: 128)
# ARGUS_EMBED_BATCH_SIZE=128

# Postgres superuser password used by docker-compose (default: argus)
# ARGUS_POSTGRES_PASSWORD=argus
